# Copie este arquivo para .env e preencha os valores
# No Railway: configure estas variáveis em Variables (não use .env)

# ── Segurança ────────────────────────────────────────────────────────────────
SENHA_PAINEL=coloque-uma-senha-aqui
SECRET_KEY=string-aleatoria-longa-e-segura-aqui

# ── Banco de dados / Auth ────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
# URL base do seu serviço Evolution API no Railway
WEBHOOK_WHATSAPP=https://evolution-api.seuusuario.up.railway.app
# Nome da instância criada no painel da Evolution API
EVOLUTION_INSTANCE=prospector
# Chave de API da Evolution API (defina na criação do serviço)
EVOLUTION_API_KEY=sua-chave-api-aqui

# ── Chrome / Scraper ─────────────────────────────────────────────────────────
HEADLESS=true
USAR_UNDETECTED=false
MAX_RESULTADOS=50

# ── Configurações de envio WhatsApp ──────────────────────────────────────────
WA_INTERVALO_MIN=8
WA_INTERVALO_MAX=15
WA_HORA_INICIO=9
WA_HORA_FIM=18
WA_DIAS_UTEIS=true

# ── IA ─────────────────────────────────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=sua-chave-groq
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=sua-chave-openrouter
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
APP_URL=https://seu-prospector.up.railway.app
