# Copie este arquivo para .env e preencha os valores
# No Railway: configure estas variáveis em Variables (não use .env)

# ── Segurança ────────────────────────────────────────────────────────────────
SENHA_PAINEL=coloque-uma-senha-aqui
SECRET_KEY=string-aleatoria-longa-e-segura-aqui

# ── Banco de dados ───────────────────────────────────────────────────────────
# No Railway: monte um volume em /data e use este path
DB_PATH=/data/prospector.db

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
# URL base do seu serviço Evolution API no Railway
WEBHOOK_WHATSAPP=https://evolution-api.seuusuario.up.railway.app
# Nome da instância criada no painel da Evolution API
EVOLUTION_INSTANCE=prospector
# Chave de API da Evolution API (defina na criação do serviço)
EVOLUTION_API_KEY=sua-chave-api-aqui

# ── Chrome / Scraper ─────────────────────────────────────────────────────────
HEADLESS=true
USAR_UNDETECTED=false
MAX_RESULTADOS=50

# ── Configurações de envio WhatsApp ──────────────────────────────────────────
WA_INTERVALO_MIN=8
WA_INTERVALO_MAX=15
WA_HORA_INICIO=9
WA_HORA_FIM=18
WA_DIAS_UTEIS=true
