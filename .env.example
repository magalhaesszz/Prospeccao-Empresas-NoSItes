# Copie este arquivo para .env e preencha os valores
# No Railway: configure estas variáveis em Variables (não use .env)

# ── Segurança ────────────────────────────────────────────────────────────────
SENHA_PAINEL=coloque-uma-senha-aqui
SECRET_KEY=string-aleatoria-longa-e-segura-aqui

# ── Banco de dados ───────────────────────────────────────────────────────────
# O projeto atual usa PostgreSQL/Supabase em database/db.py.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
# URL base do seu serviço Evolution API no Railway
WEBHOOK_WHATSAPP=https://evolution-api.seuusuario.up.railway.app
# Nome da instância criada no painel da Evolution API
EVOLUTION_INSTANCE=prospector
# Chave de API da Evolution API (defina na criação do serviço)
EVOLUTION_API_KEY=sua-chave-api-aqui

# ── Chrome / Scraper ─────────────────────────────────────────────────────────
HEADLESS=true
USAR_UNDETECTED=false
MAX_RESULTADOS=50

# Cobertura geográfica incremental (pode desligar sem perder o scraper antigo)
PROSPECT_COVERAGE_ENABLED=true
PROSPECT_MAX_CELLS=25
PROSPECT_CELL_SPACING_KM=3.5
PROSPECT_PER_CELL=18

# ── Inteligência artificial ──────────────────────────────────────────────────
AI_PROVIDER=groq
AI_FALLBACK_ORDER=openrouter,xai,groq
AI_TIMEOUT=90
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
XAI_API_KEY=
XAI_MODEL=grok-4.5

# URL pública do app usada nos links de preview
APP_URL=

# ── Configurações de envio WhatsApp ──────────────────────────────────────────
WA_INTERVALO_MIN=8
WA_INTERVALO_MAX=15
WA_HORA_INICIO=9
WA_HORA_FIM=18
WA_DIAS_UTEIS=true
