# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospector
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_PASSWORD=troque-esta-senha
# Opcional: se SUPABASE_URL + SUPABASE_ANON_KEY estiverem definidos, o login por e-mail/senha do Supabase tem prioridade
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_URL=http://localhost:8080
PORT=8080
HEADLESS=true
MAX_RESULTADOS=80

# Cobertura territorial
PROSPECT_MAX_CELLS=25
PROSPECT_CELL_SPACING_KM=3.5
PROSPECT_PER_CELL=18

# IA: groq | openrouter | xai
AI_PROVIDER=groq
AI_FALLBACK_ORDER=openrouter,xai,groq
AI_TIMEOUT=90
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
XAI_API_KEY=
XAI_MODEL=grok-4.5

# WhatsApp: evolution | meta | disabled
WA_PROVIDER=evolution
WA_DRY_RUN=true
WA_DAILY_LIMIT=50
WA_CONTACT_COOLDOWN_HOURS=72
WA_HORA_INICIO=9
WA_HORA_FIM=18
EVOLUTION_URL=
EVOLUTION_INSTANCE=prospector
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=pt_BR
META_VERIFY_TOKEN=
